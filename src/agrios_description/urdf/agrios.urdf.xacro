<?xml version="1.0"?>
<robot name="agrios" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== ARGS ===== -->
  <xacro:arg name="lock_steering" default="true"/>
  <xacro:property name="lock_steer" value="$(arg lock_steering)"/>
  <xacro:property name="steer_joint_type"
                  value="${'fixed' if lock_steer == 'true' else 'revolute'}"/>

  <!-- ===== LOCKED (from spec) ===== -->
  <xacro:property name="track_width"    value="1.35"/>
  <xacro:property name="wheel_radius"   value="0.30"/>
  <xacro:property name="wheel_width"    value="0.11"/>
  <xacro:property name="clearance"      value="0.45"/>

  <!-- ===== ASSUMED — not in spec, verify ===== -->
  <xacro:property name="wheelbase"      value="1.50"/>
  <xacro:property name="steer_limit"    value="${35*pi/180}"/>

  <!-- ===== DERIVED ===== -->
  <xacro:property name="chassis_length" value="1.80"/>
  <xacro:property name="chassis_width"  value="1.10"/>
  <xacro:property name="chassis_height" value="0.30"/>
  <xacro:property name="chassis_z"      value="${clearance - wheel_radius + chassis_height/2}"/>

  <!-- ===== MASS — PLACEHOLDER, sums to 900 kg ===== -->
  <xacro:property name="chassis_mass"   value="700"/>
  <xacro:property name="steer_mass"     value="15"/>
  <xacro:property name="wheel_mass"     value="35"/>

  <material name="grey">  <color rgba="0.4 0.4 0.4 1"/></material>
  <material name="black"> <color rgba="0.1 0.1 0.1 1"/></material>
  <material name="orange"><color rgba="0.9 0.5 0.1 1"/></material>

  <!-- ===== Inertia macros ===== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}"
               izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertia" params="m r h">
    <inertial>
      <origin rpy="${pi/2} 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" iyy="${m*(3*r*r+h*h)/12}"
               izz="${m*r*r/2}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ===== Base ===== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
        x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <!-- ===== Corner ===== -->
  <xacro:macro name="corner" params="prefix xr yr">

    <link name="${prefix}_steer_link">
      <visual>
        <geometry><box size="0.12 0.12 0.12"/></geometry>
        <material name="grey"/>
      </visual>
      <xacro:box_inertia m="${steer_mass}" x="0.12" y="0.12" z="0.12"/>
    </link>

    <joint name="${prefix}_steer_joint" type="${steer_joint_type}">
      <parent link="base_link"/>
      <child  link="${prefix}_steer_link"/>
      <origin xyz="${xr*wheelbase/2} ${yr*track_width/2} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steer_limit}" upper="${steer_limit}"
             effort="3000" velocity="1.0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steer_link"/>
      <child  link="${prefix}_wheel_link"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
      <kp>1e7</kp>
      <kd>1e3</kd>
    </gazebo>

  </xacro:macro>

  <xacro:corner prefix="fl" xr="1"  yr="1"/>
  <xacro:corner prefix="fr" xr="1"  yr="-1"/>
  <xacro:corner prefix="rl" xr="-1" yr="1"/>
  <xacro:corner prefix="rr" xr="-1" yr="-1"/>

  <!-- ===== Gazebo Fortress plugins ===== -->
  <gazebo>
    <plugin filename="ignition-gazebo-ackermann-steering-system"
        name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>fl_wheel_joint</left_joint>
      <right_joint>fr_wheel_joint</right_joint>
      <left_steering_joint>fl_steer_joint</left_steering_joint>
      <right_steering_joint>fr_steer_joint</right_steering_joint>
      <kingpin_width>${track_width}</kingpin_width>
      <steering_limit>${steer_limit}</steering_limit>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_velocity>-1.5</min_velocity>
      <max_velocity>1.5</max_velocity>
      <min_acceleration>-1.0</min_acceleration>
      <max_acceleration>1.0</max_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <tf_topic>/gz_tf_unused</tf_topic>
    </plugin>

  <plugin filename="ignition-gazebo-odometry-publisher-system"
        name="ignition::gazebo::systems::OdometryPublisher">
    <odom_frame>world</odom_frame>
    <robot_base_frame>base_footprint</robot_base_frame>
    <odom_topic>ground_truth</odom_topic>
    <odom_publish_frequency>50</odom_publish_frequency>
    <tf_topic>/gz_tf_unused</tf_topic>
    <dimensions>3</dimensions>
  </plugin>

  <plugin filename="ignition-gazebo-imu-system"
        name="ignition::gazebo::systems::Imu"/>
<plugin filename="ignition-gazebo-navsat-system"
        name="ignition::gazebo::systems::NavSat"/>

  <plugin filename="ignition-gazebo-sensors-system"
          name="ignition::gazebo::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

    <!-- ===== Mast + LiDAR mount ===== -->
  <link name="mast_link">
    <visual>
      <geometry><cylinder radius="0.03" length="1.2"/></geometry>
      <material name="grey"/>
    </visual>
    <xacro:box_inertia m="5" x="0.06" y="0.06" z="1.2"/>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="mast_link"/>
    <origin xyz="0 0 ${chassis_z + chassis_height/2 + 0.6}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="black"/>
    </visual>
    <xacro:box_inertia m="0.5" x="0.1" y="0.1" z="0.08"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="mast_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 0.65"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>


      <!-- ===== IMU — at chassis centre of rotation ===== -->
  <link name="imu_link">
    <xacro:box_inertia m="0.05" x="0.03" y="0.03" z="0.01"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 ${chassis_z}"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <ignition_frame_id>imu_link</ignition_frame_id>
      <topic>imu</topic>
      <update_rate>200</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- ===== GPS antenna A ===== -->
  <link name="gps_link">
    <xacro:box_inertia m="0.1" x="0.05" y="0.05" z="0.02"/>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="mast_link"/>
    <child  link="gps_link"/>
    <origin xyz="0 0 0.7"/>
  </joint>

  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <ignition_frame_id>gps_link</ignition_frame_id>
      <topic>navsat</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

</robot>